import types (KernelError, Drawdown) from "./model.ores";

// Scalar correctness layer.
//
// This module intentionally uses ordinary arrays rather than Region<T>. It is
// the Oreslang reference path for validation, small batches, differential
// testing, and environments where heterogeneous compute is unavailable.
//
// Ordinary reference parameters are read-only aliases under the pointer-free
// ownership work; output buffers are explicitly mutable parameters.
define module finance_scalar

  fnc count_float(Array<float> values) -> int {
    let count = 0;
    for value of values {
      count = count + 1;
    }
    return count;
  }

  fnc is_finite_value(float value) -> bool {
    // IEEE-754: finite - finite is zero, while NaN and +/-Infinity produce NaN.
    // NaN never compares equal, so this avoids a host-math dependency.
    return (value - value) == 0.0;
  }

  fnc kernel_error(string code, int index, int expected, int actual) -> KernelError {
    return KernelError{
      code: code,
      index: index,
      expected: expected,
      actual: actual
    };
  }

  fnc validate_input_count(Array<float> values, int count) -> Result<int, KernelError> {
    if count < 0 {
      return Err(kernel_error("invalid_count", -1, 0, count));
    }

    val actual = count_float(values);
    if actual != count {
      return Err(kernel_error("input_length", -1, count, actual));
    }

    return Ok(actual);
  }

  fnc validate_finite(Array<float> values, int count) -> Result<int, KernelError> {
    for int i = 0; i < count; i++ {
      if !is_finite_value(values[i]) {
        return Err(kernel_error("non_finite", i, 0, 0));
      }
    }
    return Ok(count);
  }

  pub fnc simple_returns_into(
    Array<float> prices,
    Array<float> mut out,
    int count
  ) -> Result<int, KernelError> {
    val input_shape = validate_input_count(prices, count);
    if input_shape.is_err() {
      return Err(input_shape.unwrap_safe().unwrap_or(
        kernel_error("input_length", -1, count, count_float(prices))
      ));
    }

    val expected = count == 0 ? 0 : count - 1;
    val actual_out = count_float(out);
    if actual_out != expected {
      return Err(kernel_error("output_length", -1, expected, actual_out));
    }

    val finite = validate_finite(prices, count);
    if finite.is_err() {
      // Result error projection/matching will replace this temporary unwrap
      // bridge once the monadic/core matching branch is folded in.
      return Err(finite.unwrap_safe().unwrap_or(
        kernel_error("non_finite", -1, 0, 0)
      ));
    }

    for int i = 1; i < count; i++ {
      val previous = prices[i - 1];
      if previous == 0.0 {
        return Err(kernel_error("zero_previous_price", i - 1, 0, 0));
      }
    }

    // Validation completes before the first output write: callers never
    // observe a partially-written output on a validation error.
    for int i = 1; i < count; i++ {
      out[i - 1] = prices[i] / prices[i - 1] - 1.0;
    }

    return Ok(expected);
  }

  pub fnc rolling_mean_into(
    Array<float> values,
    Array<float> mut out,
    int count,
    int window
  ) -> Result<int, KernelError> {
    val input_shape = validate_input_count(values, count);
    if input_shape.is_err() {
      return Err(kernel_error("input_length", -1, count, count_float(values)));
    }

    if window <= 0 || window > count {
      return Err(kernel_error("invalid_window", -1, count, window));
    }

    val expected = count - window + 1;
    val actual_out = count_float(out);
    if actual_out != expected {
      return Err(kernel_error("output_length", -1, expected, actual_out));
    }

    val finite = validate_finite(values, count);
    if finite.is_err() {
      for int i = 0; i < count; i++ {
        if !is_finite_value(values[i]) {
          return Err(kernel_error("non_finite", i, 0, 0));
        }
      }
    }

    let sum = 0.0;
    for int i = 0; i < window; i++ {
      sum = sum + values[i];
    }
    out[0] = sum / window;

    for int end = window; end < count; end++ {
      sum = sum + values[end] - values[end - window];
      out[end - window + 1] = sum / window;
    }

    return Ok(expected);
  }

  pub fnc mean(Array<float> values, int count) -> Result<float, KernelError> {
    val input_shape = validate_input_count(values, count);
    if input_shape.is_err() {
      return Err(kernel_error("input_length", -1, count, count_float(values)));
    }

    if count < 1 {
      return Err(kernel_error("insufficient_samples", -1, 1, count));
    }

    val finite = validate_finite(values, count);
    if finite.is_err() {
      for int i = 0; i < count; i++ {
        if !is_finite_value(values[i]) {
          return Err(kernel_error("non_finite", i, 0, 0));
        }
      }
    }

    let result = 0.0;
    for int i = 0; i < count; i++ {
      val n = i + 1;
      result = result + (values[i] - result) / n;
    }
    return Ok(result);
  }

  pub fnc sample_variance(
    Array<float> values,
    int count
  ) -> Result<float, KernelError> {
    val input_shape = validate_input_count(values, count);
    if input_shape.is_err() {
      return Err(kernel_error("input_length", -1, count, count_float(values)));
    }

    if count < 2 {
      return Err(kernel_error("insufficient_samples", -1, 2, count));
    }

    val finite = validate_finite(values, count);
    if finite.is_err() {
      for int i = 0; i < count; i++ {
        if !is_finite_value(values[i]) {
          return Err(kernel_error("non_finite", i, 0, 0));
        }
      }
    }

    let running_count = 0;
    let running_mean = 0.0;
    let m2 = 0.0;

    for int i = 0; i < count; i++ {
      running_count = running_count + 1;
      val delta = values[i] - running_mean;
      running_mean = running_mean + delta / running_count;
      val delta2 = values[i] - running_mean;
      m2 = m2 + delta * delta2;
    }

    return Ok(m2 / (running_count - 1));
  }

  pub fnc max_drawdown(
    Array<float> prices,
    int count
  ) -> Result<Option<Drawdown>, KernelError> {
    val input_shape = validate_input_count(prices, count);
    if input_shape.is_err() {
      return Err(kernel_error("input_length", -1, count, count_float(prices)));
    }

    if count == 0 {
      return Ok(None);
    }

    for int i = 0; i < count; i++ {
      val price = prices[i];
      if !is_finite_value(price) {
        return Err(kernel_error("non_finite", i, 0, 0));
      }
      if price < 0.0 {
        return Err(kernel_error("negative_price", i, 0, 0));
      }
    }

    let peak_price = prices[0];
    let peak_index = 0;
    let best_peak_index = 0;
    let best_trough_index = 0;
    let best_fraction = 0.0;

    for int i = 1; i < count; i++ {
      val price = prices[i];

      if price > peak_price {
        peak_price = price;
        peak_index = i;
        continue;
      }

      if peak_price == 0.0 {
        continue;
      }

      val fraction = 1.0 - price / peak_price;
      if fraction > best_fraction {
        best_fraction = fraction;
        best_peak_index = peak_index;
        best_trough_index = i;
      }
    }

    return Ok(Some(Drawdown{
      peak_index: best_peak_index,
      trough_index: best_trough_index,
      fraction: best_fraction
    }));
  }

end
