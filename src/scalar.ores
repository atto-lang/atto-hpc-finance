// Scalar correctness layer.

struct KernelError {
  code: string
  index: int
  expected: int
  actual: int
}

struct Drawdown {
  peak_index: int
  trough_index: int
  fraction: float
}

//
// This module intentionally uses ordinary arrays rather than Region<T>. It is
// the Oreslang reference path for validation, small batches, differential
// testing, and environments where heterogeneous compute is unavailable.
//
// Ordinary reference parameters are read-only aliases under the pointer-free
// ownership work; output buffers are explicitly mutable parameters.
define module finance_scalar

  fnc count_float(Array<float> values) -> int {
    let count = 0;
    for value of values {
      count = count + 1;
    }
    return count;
  }

  fnc is_finite_value(float value) -> bool {
    // IEEE-754: finite - finite is zero, while NaN and +/-Infinity produce NaN.
    // NaN never compares equal, so this avoids a host-math dependency.
    return (value - value) == 0.0;
  }

  fnc kernel_error(string code, int index, int expected, int actual) -> KernelError {
    return KernelError{
      code: code,
      index: index,
      expected: expected,
      actual: actual
    };
  }

  pub fnc simple_returns_into(
    Array<float> prices,
    Array<float> mut out,
    int count
  ) -> Result<int, KernelError> {
    if count < 0 {
      return Err(kernel_error("invalid_count", -1, 0, count));
    }

    val actual_prices = count_float(prices);
    if actual_prices != count {
      return Err(kernel_error("input_length", -1, count, actual_prices));
    }

    val expected = count == 0 ? 0 : count - 1;
    val actual_out = count_float(out);
    if actual_out != expected {
      return Err(kernel_error("output_length", -1, expected, actual_out));
    }

    for int i = 0; i < count; i++ {
      if !is_finite_value(prices[i]) {
        return Err(kernel_error("non_finite", i, 0, 0));
      }
    }

    for int i = 1; i < count; i++ {
      val previous = prices[i - 1];
      if previous == 0.0 {
        return Err(kernel_error("zero_previous_price", i - 1, 0, 0));
      }
    }

    // Preflight computed results too: finite inputs may still produce an
    // infinite quotient. Check every output before the first mutation.
    for int i = 1; i < count; i++ {
      val computed = prices[i] / prices[i - 1] - 1.0;
      if !is_finite_value(computed) {
        return Err(kernel_error("non_finite_result", i - 1, 0, 0));
      }
    }

    // Strict scalar math uses the same evaluation order as the preflight.
    // Future accelerated paths must prove identical failure-atomicity.
    for int i = 1; i < count; i++ {
      out[i - 1] = prices[i] / prices[i - 1] - 1.0;
    }

    return Ok(expected);
  }

  pub fnc rolling_mean_into(
    Array<float> values,
    Array<float> mut out,
    int count,
    int window
  ) -> Result<int, KernelError> {
    if count < 0 {
      return Err(kernel_error("invalid_count", -1, 0, count));
    }

    val actual_values = count_float(values);
    if actual_values != count {
      return Err(kernel_error("input_length", -1, count, actual_values));
    }

    if window <= 0 || window > count {
      return Err(kernel_error("invalid_window", -1, count, window));
    }

    val expected = count - window + 1;
    val actual_out = count_float(out);
    if actual_out != expected {
      return Err(kernel_error("output_length", -1, expected, actual_out));
    }

    for int i = 0; i < count; i++ {
      if !is_finite_value(values[i]) {
        return Err(kernel_error("non_finite", i, 0, 0));
      }
    }

    // Sliding sums of finite inputs can overflow. Preflight the *entire*
    // output vector before writing anything to the caller-owned buffer.
    let sum = 0.0;
    for int i = 0; i < window; i++ {
      sum = sum + values[i];
      if !is_finite_value(sum) {
        return Err(kernel_error("non_finite_result", 0, 0, 0));
      }
    }
    if !is_finite_value(sum / window) {
      return Err(kernel_error("non_finite_result", 0, 0, 0));
    }
    for int end = window; end < count; end++ {
      sum = sum + values[end];
      if !is_finite_value(sum) {
        return Err(kernel_error("non_finite_result", end - window + 1, 0, 0));
      }
      sum = sum - values[end - window];
      if !is_finite_value(sum) || !is_finite_value(sum / window) {
        return Err(kernel_error("non_finite_result", end - window + 1, 0, 0));
      }
    }

    sum = 0.0;
    for int i = 0; i < window; i++ {
      sum = sum + values[i];
    }
    out[0] = sum / window;
    for int end = window; end < count; end++ {
      sum = sum + values[end];
      sum = sum - values[end - window];
      out[end - window + 1] = sum / window;
    }

    return Ok(expected);
  }

  pub fnc mean(Array<float> values, int count) -> Result<float, KernelError> {
    if count < 0 {
      return Err(kernel_error("invalid_count", -1, 0, count));
    }

    val actual_values = count_float(values);
    if actual_values != count {
      return Err(kernel_error("input_length", -1, count, actual_values));
    }

    if count < 1 {
      return Err(kernel_error("insufficient_samples", -1, 1, count));
    }

    for int i = 0; i < count; i++ {
      if !is_finite_value(values[i]) {
        return Err(kernel_error("non_finite", i, 0, 0));
      }
    }

    let result = 0.0;
    for int i = 0; i < count; i++ {
      val n = i + 1;
      val value = values[i];
      // The subtraction value - result can overflow for opposite-sign
      // finite extremes even when their weighted mean is representable.
      // Match the independently maintained Rust reference's update rule.
      if (value < 0.0 && result > 0.0) || (value > 0.0 && result < 0.0) {
        result = result * ((n - 1.0) / n) + value / n;
      } else {
        result = result + (value - result) / n;
      }
    }
    return Ok(result);
  }

  pub fnc sample_variance(
    Array<float> values,
    int count
  ) -> Result<float, KernelError> {
    if count < 0 {
      return Err(kernel_error("invalid_count", -1, 0, count));
    }

    val actual_values = count_float(values);
    if actual_values != count {
      return Err(kernel_error("input_length", -1, count, actual_values));
    }

    if count < 2 {
      return Err(kernel_error("insufficient_samples", -1, 2, count));
    }

    for int i = 0; i < count; i++ {
      if !is_finite_value(values[i]) {
        return Err(kernel_error("non_finite", i, 0, 0));
      }
    }

    let running_count = 0;
    let running_mean = 0.0;
    let m2 = 0.0;

    for int i = 0; i < count; i++ {
      running_count = running_count + 1;
      val delta = values[i] - running_mean;
      running_mean = running_mean + delta / running_count;
      val delta2 = values[i] - running_mean;
      m2 = m2 + delta * delta2;
      if !is_finite_value(running_mean) || !is_finite_value(m2) {
        return Err(kernel_error("non_finite_result", 0, 0, 0));
      }
    }

    val variance = m2 / (running_count - 1);
    if !is_finite_value(variance) {
      return Err(kernel_error("non_finite_result", 0, 0, 0));
    }
    return Ok(variance);
  }

  pub fnc max_drawdown(
    Array<float> prices,
    int count
  ) -> Result<Option<Drawdown>, KernelError> {
    if count < 0 {
      return Err(kernel_error("invalid_count", -1, 0, count));
    }

    val actual_prices = count_float(prices);
    if actual_prices != count {
      return Err(kernel_error("input_length", -1, count, actual_prices));
    }

    if count == 0 {
      return Ok(None);
    }

    for int i = 0; i < count; i++ {
      val price = prices[i];
      if !is_finite_value(price) {
        return Err(kernel_error("non_finite", i, 0, 0));
      }
      if price < 0.0 {
        return Err(kernel_error("negative_price", i, 0, 0));
      }
    }

    let peak_price = prices[0];
    let peak_index = 0;
    let best_peak_index = 0;
    let best_trough_index = 0;
    let best_fraction = 0.0;

    for int i = 1; i < count; i++ {
      val price = prices[i];

      if price > peak_price {
        peak_price = price;
        peak_index = i;
        continue;
      }

      if peak_price == 0.0 {
        continue;
      }

      val fraction = 1.0 - price / peak_price;
      if fraction > best_fraction {
        best_fraction = fraction;
        best_peak_index = peak_index;
        best_trough_index = i;
      }
    }

    return Ok(Some(Drawdown{
      peak_index: best_peak_index,
      trough_index: best_trough_index,
      fraction: best_fraction
    }));
  }

end
