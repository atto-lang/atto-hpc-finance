import module finance_risk_scalar from "../src/risk_scalar.ores";

// THIS FILE IS A REAL ORESLANG GUEST ACCEPTANCE PROGRAM, NOT A HOST TEST.
// Independent source: fixtures/risk-gate-v1.tsv; all 23 IDs present once.
// Required strict IEEE-754 behavior, including NaN and +/-Infinity.
// Expected stdout: 23 colon-delimited "true" values. No trailing newline.
// Do not certify as executable until a pinned compiler has run this exact blob.
fnc check(
  int side,
  float quantity,
  float limit_price,
  float max_quantity,
  bool expected_approved,
  int expected_reason
) -> bool {
  val decision = finance_risk_scalar.limit_order(
    side, quantity, limit_price, max_quantity
  );
  return decision.approved == expected_approved &&
         decision.reason_code == expected_reason;
}

pub routine main() -> void {
  val float huge = 1.0e308;
  val float positive_infinity = huge * huge;
  val float negative_infinity = 0.0 - positive_infinity;
  val float nonfinite_nan = positive_infinity - positive_infinity;

  // fixture:allow_buy
  stdio.stdout.write(check(1, 1.0, 10.0, 2.0, true, 0));
  stdio.stdout.write(":");
  // fixture:allow_sell
  stdio.stdout.write(check(-1, 1.0, 10.0, 2.0, true, 0));
  stdio.stdout.write(":");
  // fixture:allow_at_max
  stdio.stdout.write(check(1, 2.0, 10.0, 2.0, true, 0));
  stdio.stdout.write(":");
  // fixture:reject_no_side
  stdio.stdout.write(check(0, 1.0, 10.0, 2.0, false, 1));
  stdio.stdout.write(":");
  // fixture:reject_invalid_side_plus
  stdio.stdout.write(check(2, 1.0, 10.0, 2.0, false, 5));
  stdio.stdout.write(":");
  // fixture:reject_invalid_side_minus
  stdio.stdout.write(check(-2, 1.0, 10.0, 2.0, false, 5));
  stdio.stdout.write(":");
  // fixture:reject_negative_quantity
  stdio.stdout.write(check(1, -1.0, 10.0, 2.0, false, 2));
  stdio.stdout.write(":");
  // fixture:reject_zero_quantity
  stdio.stdout.write(check(1, 0.0, 10.0, 2.0, false, 7));
  stdio.stdout.write(":");
  // fixture:reject_negative_zero_quantity
  stdio.stdout.write(check(1, -0.0, 10.0, 2.0, false, 7));
  stdio.stdout.write(":");
  // fixture:reject_zero_limit_price
  stdio.stdout.write(check(1, 1.0, 0.0, 2.0, false, 6));
  stdio.stdout.write(":");
  // fixture:reject_negative_limit_price
  stdio.stdout.write(check(1, 1.0, -1.0, 2.0, false, 6));
  stdio.stdout.write(":");
  // fixture:reject_over_limit
  stdio.stdout.write(check(1, 3.0, 10.0, 2.0, false, 3));
  stdio.stdout.write(":");
  // fixture:reject_zero_max
  stdio.stdout.write(check(1, 1.0, 10.0, 0.0, false, 3));
  stdio.stdout.write(":");
  // fixture:reject_negative_max
  stdio.stdout.write(check(1, 1.0, 10.0, -1.0, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_quantity_nan
  stdio.stdout.write(check(1, nonfinite_nan, 10.0, 2.0, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_quantity_positive_inf
  stdio.stdout.write(check(1, positive_infinity, 10.0, 2.0, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_quantity_negative_inf
  stdio.stdout.write(check(1, negative_infinity, 10.0, 2.0, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_limit_nan
  stdio.stdout.write(check(1, 1.0, nonfinite_nan, 2.0, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_limit_positive_inf
  stdio.stdout.write(check(1, 1.0, positive_infinity, 2.0, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_limit_negative_inf
  stdio.stdout.write(check(1, 1.0, negative_infinity, 2.0, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_max_nan
  stdio.stdout.write(check(1, 1.0, 10.0, nonfinite_nan, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_max_positive_inf
  stdio.stdout.write(check(1, 1.0, 10.0, positive_infinity, false, 4));
  stdio.stdout.write(":");
  // fixture:reject_max_negative_inf
  stdio.stdout.write(check(1, 1.0, 10.0, negative_infinity, false, 4));
  return;
}
